# Supabase Configuration
# Obtén estos valores desde: https://app.supabase.com/project/_/settings/api
#
# Copia este archivo a `.env.local` para desarrollo y a `.env.production` para builds de deploy
# (`npm run build:deploy` / scripts deploy:* solo cargan `.env.production`).

# URL de tu proyecto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon/Public Key (segura para usar en el cliente)
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL base del sitio, para los enlaces que Supabase envía por correo.
# Hoy la usa la confirmación del alta; la recuperación de contraseña la usará
# cuando exista (ver odd/tasks/acceso.md).
# En local es el servidor de desarrollo de Expo; en producción, la URL pública.
EXPO_PUBLIC_SITE_URL=http://localhost:8081
