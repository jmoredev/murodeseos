{
    "expo": {
        "name": "Muro de Deseos",
        "slug": "murodeseos",
        "version": "1.4.0",
        "orientation": "portrait",
        "icon": "./public/favicon.ico",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "resizeMode": "contain",
            "backgroundColor": "#fff4f4"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#fff4f4"
            }
        },
        "web": {
            "favicon": "./public/favicon.ico",
            "bundler": "metro",
            "output": "static",
            "name": "Muro de Deseos",
            "shortName": "MuroDeseos",
            "themeColor": "#aa2c32",
            "backgroundColor": "#fff4f4",
            "display": "standalone",
            "description": "Comparte tus sueños y organiza tus regalos."
        },
        "plugins": [
            "expo-router"
        ],
        "experiments": {
            "typedRoutes": true,
            "baseUrl": "/murodeseos"
        }
    }
}